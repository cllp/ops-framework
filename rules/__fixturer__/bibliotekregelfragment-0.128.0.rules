    // ══ Ramverkets bibliotek. GENERERAD, ändra inte för hand ══
    //
    // Källa: ops-framework, bibliotekregelfragment() i src/lib/regler.js. Kräver regelfragment() ovanför.

    // En tid i millisekunder nära serverns klocka (samma uttryck som samtalens opsNu).
    function opsBiblioteketNu(t) {
      return t is int && t > request.time.toMillis() - 300000 && t < request.time.toMillis() + 300000;
    }

    // ⛔ VÅGEN ÄR EN STRÄNG, ETT TECKEN PER STOLPE, och prövas med ETT uttryck (https://github.com/cllp/ops-framework/issues/349).
    // CP 2026-10-13: en röstinspelning med våg nekades med "Missing or insufficient permissions.", eftersom 48 tal som
    // vart och ett prövades för sig gick över Firestores tak på 1000 uttryck per skrivning. Längd och teckenmängd är samma
    // matches(): mönstret kommer ur TOPPFORM i bibliotek.js, så det inte kan glida isär från modellens peaksGiltiga.
    // Ingen separat "is string" eller size(): mönstret kräver exakt 48 tecken, och matches() på något som
    // inte är en sträng är ett fel, och ett fel är ett nej (regel 4: ett villkor som inte kan ändra utfallet är ingen spärr).
    function opsBibliotekToppar(p) {
      return p.matches('[A-Za-z0-9_-]{48}');
    }

    // Filens sökväg är EXAKT {gruppPrefix}/{groupId}/{postPrefix}/{postId}/{filnamn}: fem segment, postens egen grupp och
    // postens eget id. Segment mot segment med ==, inte regex. Inget segment är tomt, '.' eller '..', och inget styrtecken
    // (radbrytning, tabb, NUL) får finnas: RE2:s punkt matchar inte radbrytning, så ett '..'-prov med regex släpper igenom
    // 'p\n/../..'.
    function opsBibliotekSokvagIGruppen(d, postId) {
      let s = d.fil.sokvag.split('/');
      // Formen först: fem icke-tomma segment utan snedstreck i sig. split() släpper ett avslutande tomt segment (Javas regel),
      // så 'a/b/c/d/e/' blev fem segment och passerade, mätt i emulatorn 2026-10-12. Mönstret fångar det, ett tomt segment i
      // mitten och ett inledande snedstreck.
      return d.fil.sokvag.matches('[^/]+/[^/]+/[^/]+/[^/]+/[^/]+')
        && s.size() == 5
        && s[0] == "grupper"
        && s[1] == d.groupId
        && s[2] == "bibliotek"
        && s[3] == postId
        && s.hasAny(['', '.', '..']) == false
        && !d.fil.sokvag.matches('(?s).*[\x00-\x1f].*');
    }

    // ⛔ TAGGARNA (0.100.0, lifehub.app#214): en lista, högst 8, inga dubbletter, och varje tagg i TAGGFORM ur bibliotek.js.
    // Regler har ingen loop, så varje plats prövas för sig, rullad ut till taket. Mönstret är samma uttryck som modellens
    // taggarFel (regelRegex), så de två kan inte glida isär. En plats bortom listans längd prövas inte: size() < k+1.
    function opsBibliotekTaggar(t) {
      return t is list
        && t.size() <= 8
        && t.toSet().size() == t.size()
        && (t.size() < 1 || t[0].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'))
        && (t.size() < 2 || t[1].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'))
        && (t.size() < 3 || t[2].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'))
        && (t.size() < 4 || t[3].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'))
        && (t.size() < 5 || t[4].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'))
        && (t.size() < 6 || t[5].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'))
        && (t.size() < 7 || t[6].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'))
        && (t.size() < 8 || t[7].matches('[a-z0-9åäöæøüéèêàâçîïôûëÿ]([a-z0-9åäöæøüéèêàâçîïôûëÿ -]{0,22}[a-z0-9åäöæøüéèêàâçîïôûëÿ])?'));
    }

    // ⛔ MITT BIBLIOTEK (0.101.0, lifehub.app#226): platsen mitt~<uid> är den inloggades egen, och bara hens. En jämförelse med
    // request.auth.uid, inget uppslag: ingen roll i någon grupp ger något här. Ett grupp-id kan inte se ut så, eftersom ett grupp-id aldrig har ett ~.
    function opsBibliotekMitt(gid) {
      return request.auth != null && gid == 'mitt~' + request.auth.uid;
    }

    // ⛔ GRENARNA UTESLUTER VARANDRA (granskningen av PR 365). En plats som ser ut som mitt~… prövas BARA mot uid:t, aldrig mot
    // memberships. Med "eller" hade ett medlemskap vars groupId råkade vara mitt~<uid> öppnat någons eget bibliotek för läsning,
    // ändring och radering, sett i emulatorn. Inget skapar ett sådant medlemskap i dag, men ett skydd som vilar på det är inget skydd.
    function opsBibliotekArMitt(gid) {
      return gid is string && gid.matches('(?s)mitt~.*');
    }
    function opsBibliotekPlatsMedlem(gid) {
      return opsBibliotekArMitt(gid) ? opsBibliotekMitt(gid) : opsArMedlem(gid);
    }
    function opsBibliotekPlatsAdmin(gid) {
      return opsBibliotekArMitt(gid) ? false : opsArAdmin(gid);
    }

    // ⛔ KÄLLAN PÅ EN LÄNK ÄR HÄRLEDD UR ADRESSEN (0.128.0, lifehub.app#378): värdlistan är LANKKALLOR i lankkalla.js, samma som modellen (lankKalla) och nodsidan läser.
    // En `kalla` som inte stämmer med `url` nekas, så att ingen sätter Spotifys märke på en annan adress.
    function opsBibliotekKalla(d) {
      return d.kalla == 'spotify' ? d.url.matches('https://(open[.]spotify[.]com)([/?#][!-~]*)?')
        : d.kalla == 'youtube' ? d.url.matches('https://(www[.]youtube[.]com|youtube[.]com|m[.]youtube[.]com|music[.]youtube[.]com|youtu[.]be)([/?#][!-~]*)?')
        : d.kalla == 'applemusic' ? d.url.matches('https://(music[.]apple[.]com)([/?#][!-~]*)?')
        : d.kalla == 'soundcloud' ? d.url.matches('https://(soundcloud[.]com|www[.]soundcloud[.]com|m[.]soundcloud[.]com)([/?#][!-~]*)?')
        : d.kalla == 'annat' ? !(d.url.matches('https://(open[.]spotify[.]com)([/?#][!-~]*)?')
          || d.url.matches('https://(www[.]youtube[.]com|youtube[.]com|m[.]youtube[.]com|music[.]youtube[.]com|youtu[.]be)([/?#][!-~]*)?')
          || d.url.matches('https://(music[.]apple[.]com)([/?#][!-~]*)?')
          || d.url.matches('https://(soundcloud[.]com|www[.]soundcloud[.]com|m[.]soundcloud[.]com)([/?#][!-~]*)?'))
        : false;
    }

    // ⛔ POSTERNA I EN LISTA (0.128.0, lifehub.app#378): en lista (inte en sträng), högst 200, inga dubbletter och varje id en sträng på POSTIDFORM. Regler har ingen loop, och 200 `matches()`
    // hade gått över Firestores tak på 1000 uttryck per skrivning (samma lärdom som vågen, #349). Därför prövas ALLA id med ETT uttryck: listan sammanfogas med komma och matchas
    // mot ett mönster som är id, följt av noll eller fler (komma, id). Antalet bärs av size() och inte av en begränsad upprepning (RE2 vägrar upprepningar i upprepningar över 1000).
    // En tom lista har inget att sammanfoga och prövas för sig.
    //
    // ⛔ SAMMANFOGNINGEN SÄGER INGET OM TYPERNA, OCH DEN SÄGER INTE HELLER HUR MÅNGA ELEMENT DET VAR. Mätt i emulatorn: join() gör heltal, null och sant/falskt till text, så ["a", 5], ["a", null] och
    // ["a", true] sammanfogades till "a,5", "a,null" och "a,true", som mönstret släpper igenom som id. Och ["a,b"] blir "a,b", två id ur ett element. Därför ska listan delas på komma igen och vara
    // LIKA med den man började med: en lista är lika med en annan bara om varje element har samma typ och värde. Ett tal, ett null, en bool eller ett element med komma i sig ger en annan lista
    // och nekas, med ETT uttryck till.
    function opsBibliotekPoster(p) {
      return p is list
        && p.size() <= 200
        && p.toSet().size() == p.size()
        && (p.size() == 0 || (
          p.join(',').matches('[A-Za-z0-9][A-Za-z0-9_-]{0,127}(,[A-Za-z0-9][A-Za-z0-9_-]{0,127})*')
          && p.join(',').split(',') == p
        ));
    }

    // ⛔ HTML-DOKUMENT OCH DERAS VERSIONER (0.156.0, cllp/ops-framework#472). Ett HTML-dokument är en filpost med MIME text/html. Dess nuvarande version står på posten (fil och version), de ersatta som egna dokument i
    // (ingen samling angiven: ett HTML-dokuments fil går inte att byta). Version 1 har inget fält version.
    function opsBibliotekArHtml(d) {
      return d.typ == "fil" && d.fil.mime == "text/html";
    }
    function opsBibliotekVersionNr(d) {
      return d.get('version', null) == null ? 1 : d.version.nr;
    }
    // Fältet version: nr (2 till 1000), vem som skrev versionen (en person, samma stämpel som skapadAv) och när. Den som redan står på raden får stå kvar, så en annan ändring av posten (titeln) nekas inte.
    function opsBibliotekVersionGiltig(v, fore) {
      return v is map
        && v.keys().hasOnly(["nr", "av", "tid"])
        && v.nr is int
        && v.nr >= 2
        && v.nr <= 1000
        && v.tid is int
        && v.av is map
        && opsSkaparstampel(v.av, fore)
        && v.av.uid is string
        && v.av.namn is string
        && v.av.typ == "manniska"
        && v.av.kalla is string;
    }
    // Ändringen av ett HTML-dokument, före och efter. Utan nytt version-fält står filen still. Med det: nästa nummer, av den som skriver, med postens nya andrad som tid, en annan fil, och versionsdokumentet för den ersatta
    // versionen finns efter skrivningen (existsAfter). Dokumentets INNEHÅLL prövar versionsdokumentets egen regel (versionsregelfragment), som kräver att det är exakt posten som den var.
    function opsBibliotekHtmlSteg(fore, efter, postId) {
      return (efter.get('version', null) == fore.get('version', null)
          && (!opsBibliotekArHtml(fore)
            || (efter.fil.sokvag == fore.fil.sokvag && efter.fil.byte == fore.fil.byte && efter.fil.mime == fore.fil.mime)))
        || false;
    }

    function opsBibliotekspostGiltig(d, postId) {
      return d.keys().hasOnly(["groupId", "typ", "rubrik", "text", "url", "kalla", "bild", "poster", "fil", "utskrift", "utskriftJobb", "durationMs", "peaks", "taggar", "version", "skapadAv", "skapad", "andrad"])
        && (!d.keys().hasAny(["taggar"]) || opsBibliotekTaggar(d.taggar))
        && d.rubrik.trim().size() > 0
        && d.rubrik.size() <= 200
        && opsSkaparstampel(d.skapadAv, resource == null ? null : resource.data.get('skapadAv', null))
        && d.skapadAv.namn is string
        && d.skapadAv.typ == "manniska"
        && d.skapadAv.kalla is string
        && d.andrad >= d.skapad
        && (
          (d.typ == "anteckning"
            && d.text.trim().size() > 0
            && d.text.size() <= 8000
            && !d.keys().hasAny(["url", "kalla", "bild", "poster", "fil", "utskrift", "utskriftJobb", "durationMs", "peaks", "version"]))
          || (d.typ == "lank"
            && d.url.size() <= 2000
            && d.url.matches('https?://[!-~]+')
            && (!d.keys().hasAny(["kalla"]) || opsBibliotekKalla(d))
            && (!d.keys().hasAny(["bild"]) || (d.bild.size() <= 2000 && d.bild.matches('https://[!-~]+')))
            && !d.keys().hasAny(["text", "poster", "fil", "utskrift", "utskriftJobb", "durationMs", "peaks", "version"]))
          || (d.typ == "lista"
            && d.keys().hasAll(["poster"])
            && opsBibliotekPoster(d.poster)
            && !d.keys().hasAny(["text", "url", "kalla", "bild", "fil", "utskrift", "utskriftJobb", "durationMs", "peaks", "version"]))
          || (d.typ == "fil"
            && d.fil.keys().hasOnly(["sokvag", "namn", "mime", "byte", "klar"])
            && (!('klar' in d.fil) || d.fil.klar is bool)
            && d.fil.sokvag.size() > 0
            && d.fil.sokvag.size() <= 1024
            && !d.fil.sokvag.matches('.*\\.\\..*')
            && opsBibliotekSokvagIGruppen(d, postId)
            && d.fil.namn.size() > 0
            && d.fil.namn.size() <= 200
            && d.fil.mime.matches('^(image/jpeg|image/png|image/webp|image/gif|audio/webm|audio/mp4|audio/mpeg|audio/ogg|audio/wav|audio/aiff|audio/flac|audio/aac|video/mp4|video/quicktime|application/pdf|text/plain|text/html)$')
            && d.fil.byte is int
            && d.fil.byte > 0
            && (d.fil.byte <= 26214400 || (d.fil.mime.matches('^audio/.*') && d.fil.byte <= 262144000) || (d.fil.mime.matches('^video/.*') && d.fil.byte <= 104857600))
            && !d.keys().hasAny(["text", "url", "kalla", "bild", "poster"])
            && (!d.keys().hasAny(["version"]) || (opsBibliotekArHtml(d) && opsBibliotekVersionGiltig(d.version, resource == null ? null : resource.data.get('version', {}).get('av', null))))
            && (
              !d.keys().hasAny(["utskrift"])
              || (d.utskrift.size() <= 20000 && d.fil.mime.matches('^audio/.*'))
            )
            && (
              !d.keys().hasAny(["utskriftJobb"])
              || (d.utskriftJobb is map && d.fil.mime.matches('^audio/.*'))
            )
            && (
              !d.keys().hasAny(["durationMs"])
              || (d.durationMs is int && d.durationMs > 0 && d.durationMs <= 43200000 && d.fil.mime.matches('^audio/.*'))
            )
            && (
              !d.keys().hasAny(["peaks"])
              || (opsBibliotekToppar(d.peaks) && d.fil.mime.matches('^audio/.*'))
            ))
        );
    }

    match /bibliotek/{id} {
      allow read: if opsBibliotekPlatsMedlem(resource.data.groupId);
      allow create: if (
          opsBibliotekArMitt(request.resource.data.groupId)
            ? opsBibliotekMitt(request.resource.data.groupId)
            : (opsArMedlem(request.resource.data.groupId) && opsMedlemskapet(request.resource.data.groupId).data.typ == 'person')
        )
        && request.resource.data.skapadAv.uid == request.auth.uid
        && opsBiblioteketNu(request.resource.data.skapad)
        && opsBiblioteketNu(request.resource.data.andrad)
        // ⛔ UTSKRIFTSJOBBET SKRIVS BARA AV SERVERN (0.133.0). En klient kan inte skapa en post som påstår att en utskrift pågår.
        && !request.resource.data.keys().hasAny(["utskriftJobb"])
        // ⛔ EN NY POST ÄR VERSION 1 OCH HAR INGET FÄLT version (0.156.0): numret räknas bara upp av ett versionssteg på en post som finns.
        && !request.resource.data.keys().hasAny(["version"])
        && opsBibliotekspostGiltig(request.resource.data, id);
      allow update: if request.resource.data.groupId == resource.data.groupId
        && request.resource.data.typ == resource.data.typ
        && request.resource.data.skapad == resource.data.skapad
        && request.resource.data.skapadAv == resource.data.skapadAv
        // ⛔ UTSKRIFTSJOBBET STÅR STILLA VID EN KLIENTS ÄNDRING (0.133.0): det sätts och tas bort av servern (Admin SDK, som går förbi reglerna). En klient som satte, ändrade eller tog bort
        // det kunde stänga av en pågående utskrift eller låtsas att en pågick, och en rad som säger "pågår" fast inget pågår är en rad ingen tar sig ur.
        && request.resource.data.get('utskriftJobb', null) == resource.data.get('utskriftJobb', null)
        && (
          opsBiblioteketNu(request.resource.data.andrad)
          || (request.resource.data.andrad == resource.data.andrad
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["durationMs", "peaks"]))
        )
        && opsBibliotekspostGiltig(request.resource.data, id)
        && opsBibliotekHtmlSteg(resource.data, request.resource.data, id)
        && (
          (opsBibliotekPlatsMedlem(resource.data.groupId) && resource.data.skapadAv.uid == request.auth.uid)
          || opsBibliotekPlatsAdmin(resource.data.groupId)
        );
      allow delete: if (opsBibliotekPlatsMedlem(resource.data.groupId) && resource.data.skapadAv.uid == request.auth.uid)
        || opsBibliotekPlatsAdmin(resource.data.groupId);
    }
