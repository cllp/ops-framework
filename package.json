{
  "name": "ops-framework",
  "version": "0.74.0",
  "type": "module",
  "description": "Tokens, primitiver, arbetsregler och vakter. Delas av alla ops-plattformar.",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./package.json": "./package.json",
    "./node": {
      "default": "./src/node/index.js"
    },
    "./gruppmarke": {
      "types": "./dist/types/gruppmarke/index.d.ts",
      "default": "./src/gruppmarke/index.js"
    },
    "./sentry": {
      "default": "./src/sentry.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "src",
    "fonts",
    "tokens",
    "scripts",
    "skills",
    "CLAUDE.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "generate:version": "node scripts/generate-framework-version.mjs",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "prebuild": "npm run generate:version && npm run generate:tokens",
    "pretest": "npm run generate:version && npm run generate:tokens",
    "precheck:types": "npm run generate:version && npm run generate:tokens",
    "build": "node scripts/build.mjs && npx tsc -p tsconfig.build.json",
    "prepare": "node scripts/generate-framework-version.mjs && node scripts/build.mjs && npx tsc -p tsconfig.build.json",
    "check:tokens": "node tokens/check-tokens.mjs tokens/tokens.css",
    "check:closed-api": "node scripts/check-closed-api.mjs src",
    "check:css-build": "node scripts/check-css-build.mjs",
    "check:guards": "node scripts/test-guards.mjs",
    "check": "npm run build && npm run check:types && npm run check:tokens && npm run check:exports && npm run check:docs && npm run check:closed-api && npm run check:data-layer && npm run check:node-side && npm run check:config-requirements && npm run check:css-build && npm run check:fonts && npm run check:chart-colors && npm run check:page-frame && npm run check:slider && npm run check:kontrast && npm run check:statusord && npm run check:sprak && npm run check:gruppikoner && npm run check:gruppmarke && npm run check:gruppfarg && npm run check:datumnamn && npm run check:handritade-ikoner && npm run check:typografi && npm run check:paketform && npm run check:gammalt-namn && npm run check:gruppnyckel && npm run check:gruppfraga && npm run check:regelgenerator && npm run check:exempelmodul && npm run check:prova-modul && npm run check:utvecklarord && npm run check:guards && npm test",
    "test": "vitest run",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "check:all": "npm run check && npm run check:viewport-guard && npm run check:scaffold && npm run check:skalyta && npm run check:paket",
    "check:exports": "node scripts/check-exports.mjs",
    "check:adoption": "node scripts/check-adoption.mjs",
    "check:types": "npx tsc -p tsconfig.json",
    "check:docs": "node scripts/check-docs.mjs",
    "check:data-layer": "node scripts/check-data-layer.mjs src",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:chart-colors": "node scripts/check-chart-colors.mjs",
    "check:node-side": "node scripts/check-node-side.mjs",
    "check:config-requirements": "node scripts/check-config-requirements.mjs",
    "check:page-frame": "node scripts/check-page-frame.mjs",
    "check:slider": "node scripts/check-slider.mjs",
    "check:kontrast": "node scripts/check-kontrast.mjs",
    "check:statusord": "node scripts/check-statusord.mjs",
    "check:datumnamn": "node scripts/check-datumnamn.mjs",
    "check:handritade-ikoner": "node scripts/check-handritade-ikoner.mjs",
    "check:typografi": "node scripts/check-typografi.mjs",
    "check:skalyta": "node scripts/check-skalyta.mjs",
    "check:utvecklarord": "node scripts/check-utvecklarord.mjs",
    "check:paketform": "node scripts/check-paket.mjs --struktur",
    "check:gammalt-namn": "node scripts/check-gammalt-namn.mjs",
    "check:paket": "node scripts/check-paket.mjs",
    "check:viewport-guard": "node scripts/test-viewport-guard.mjs",
    "regler:skriv": "node scripts/skriv-provregler.mjs",
    "test:rules": "npm run regler:skriv && npx --yes firebase-tools@14 emulators:exec --only firestore --project regelprov \"node --test --test-concurrency=1 rules/__tests__/*.test.mjs\"",
    "check:exempelmodul": "node scripts/check-exempelmodul.mjs",
    "check:prova-modul": "node scripts/prova-modul.mjs examples/paminnelser/index.js --grupp bolaget",
    "check:regelgenerator": "node scripts/check-regelgenerator.mjs",
    "check:gruppfraga": "node scripts/check-gruppfraga.mjs",
    "check:gruppnyckel": "node scripts/check-gruppnyckel.mjs",
    "check:sprak": "node scripts/check-sprak.mjs",
    "generate:gruppikoner": "node scripts/generate-gruppikoner.mjs",
    "check:gruppikoner": "node scripts/generate-gruppikoner.mjs --kontrollera",
    "check:gruppfarg": "node scripts/check-gruppfarg.mjs",
    "check:gruppmarke": "node scripts/check-gruppmarke.mjs"
  },
  "peerDependencies": {
    "@sentry/browser": ">=8",
    "lucide-react": "^0.460.0",
    "playwright": ">=1.40",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "react-day-picker": "^10.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "lucide-static": "0.460.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.4.0"
  },
  "types": "./dist/types/index.d.ts",
  "bin": {
    "ops-viewport": "./scripts/ops-viewport.mjs"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@sentry/browser": {
      "optional": true
    }
  }
}
