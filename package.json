{
  "name": "@staiger/ops-framework",
  "version": "0.13.0",
  "type": "module",
  "description": "Tokens, primitiver, arbetsregler och vakter. Delas av alla ops-plattformar.",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./package.json": "./package.json",
    "./nod": {
      "default": "./src/nod/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "tokens",
    "scripts",
    "skills",
    "CLAUDE.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npx tsc -p tsconfig.build.json",
    "prepare": "node scripts/build.mjs && npx tsc -p tsconfig.build.json",
    "check:tokens": "node tokens/check-tokens.mjs tokens/tokens.css",
    "check:closed-api": "node scripts/check-closed-api.mjs src",
    "check:css-build": "node scripts/check-css-build.mjs",
    "check:guards": "node scripts/test-guards.mjs",
    "check": "npm run build && npm run check:types && npm run check:tokens && npm run check:exports && npm run check:docs && npm run check:closed-api && npm run check:data-layer && npm run check:nodsida && npm run check:konfigkrav && npm run check:css-build && npm run check:typsnitt && npm run check:diagramfarger && npm run check:sidram && npm run check:reglage && npm run check:guards && npm test",
    "test": "vitest run",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "check:all": "npm run check && npm run check:scaffold",
    "check:exports": "node scripts/check-exports.mjs",
    "check:adoption": "node scripts/check-adoption.mjs",
    "check:types": "npx tsc -p tsconfig.json",
    "check:docs": "node scripts/check-docs.mjs",
    "check:data-layer": "node scripts/check-data-layer.mjs src",
    "check:typsnitt": "node scripts/check-typsnitt.mjs",
    "check:diagramfarger": "node scripts/check-diagramfarger.mjs",
    "check:nodsida": "node scripts/check-nodsida.mjs",
    "check:konfigkrav": "node scripts/check-konfigkrav.mjs",
    "check:sidram": "node scripts/check-sidram.mjs",
    "check:reglage": "node scripts/check-reglage.mjs"
  },
  "peerDependencies": {
    "lucide-react": "^0.460.0",
    "playwright": ">=1.40",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "react-day-picker": "^10.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "types": "./dist/types/index.d.ts",
  "bin": {
    "ops-viewport": "./scripts/ops-viewport.mjs"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
