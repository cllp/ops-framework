{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.js", "src/**/*.jsx"],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__",
    // ⛔ #159: src/sentry.js importerar @sentry/browser, en SDK ramverket
    // avsiktligt inte installerar åt sig självt (peerDependency, optional,
    // laddas bara av den app som väljer Sentry). En typkontroll av en modul
    // som inte finns i det här repot vore bara ett annat sätt att tvinga
    // fram beroendet ändå. Se filhuvudet i src/sentry.js.
    "src/sentry.js"
  ]
}
